NODE_ENV = development

PORT = 5000

# PostgreSQL Connection
DB_NAME = mobile_auth_db
DB_USER = postgres
DB_PASSWORD = "yourpassword"
DB_HOST = localhost
DB_PORT = 5432

# JWT
JWT_SECRET = <YOUR_LONG_JWT_SECRET_MIN_32_CHARS>
JWT_EXPIRY = 7d

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
# Max OTP send requests per mobile per window
OTP_RATE_LIMIT_MAX=5
# Window in minutes for OTP rate limiting
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# ─── SMS Provider ─────────────────────────────────────────────────────────────
# Options: fast2sms | twilio | msg91 | console
# Use 'console' to skip SMS entirely and just print OTP in terminal (dev/testing)
# NODE_ENV=development also always uses console regardless of this setting
SMS_PROVIDER = fast2sms

# ── Fast2SMS 
FAST2SMS_API_KEY = <YOUR_FAST2SMS_API_KEY>

# ── Twilio 
# TWILIO_ACCOUNT_SID = <YOUR_TWILIO_ACCOUNT_SID>
# TWILIO_AUTH_TOKEN  = <YOUR_TWILIO_AUTH_TOKEN>
# TWILIO_PHONE_NUMBER = <YOUR_TWILIO_PHONE_NUMBER>

# ── MSG91 
# MSG91_AUTH_KEY   = <YOUR_MSG91_AUTH_KEY>
# MSG91_SENDER_ID  = MAUTH
# MSG91_TEMPLATE_ID = <YOUR_MSG91_TEMPLATE_ID>

FRONTEND_URL = http://localhost:3000

# ─── Razorpay (Subscription payments) ─────────────────────────────────────────
# Test mode keys — Dashboard → Settings → API Keys → Generate Test Key
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID = <YOUR_RAZORPAY_TEST_KEY_ID>
RAZORPAY_KEY_SECRET = <YOUR_RAZORPAY_TEST_KEY_SECRET>

# How many days a plan stays active after successful payment (simple model, no auto-debit)
SUBSCRIPTION_VALIDITY_DAYS=30